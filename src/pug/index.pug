html(lang="en")
    head
        title Page title
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width, initial-scale=1, shrink-to-fit=no")
        link(rel="stylesheet", href="https://fonts.cdnfonts.com/css/general-sans?styles=135312,135310,135313,135303")
        link(rel="stylesheet", href="css/bootstrap/bootstrap.min.css")
        link(rel="stylesheet", href="css/main.css")
        link(rel="icon", type="image/png", sizes="32x32", href="shuffle-for-bootstrap.png")
    body
        div(class="")
            section(class="pb-20")
                nav(class="navbar navbar-expand-lg navbar-light bg-light")
                    div(class="container")
                        a(class="navbar-brand", href="#")
                            img(class="img-fluid", src="images/icon-containerdienst.webp", alt="")
                        div(class="collapse navbar-collapse me-5 justify-content-end")
                            ul(class="navbar-nav")
                                li(class="nav-item")
                                    a(class="nav-link", href="#") Home
                                li(class="nav-item")
                                    a(class="nav-link", href="#") Abfallarten
                                li(class="nav-item")
                                    a(class="nav-link", href="#") Regionale Containerdienste
                                li(class="nav-item")
                                    a(class="nav-link", href="#") Containerdienst eintragen
                        div(class="d-none d-lg-block")
                            a(class="btn btn-primary", href="#") Angebot anfordern
                        div(class="d-lg-none")
                            button(class="btn navbar-burger p-0")
                                svg(class="text-primary", width="51", height="51", viewbox="0 0 56 56", fill="none", xmlns="http://www.w3.org/2000/svg")
                                    rect(width="56", height="56", rx="28", fill="currentColor")
                                    path(d="M37 32H19M37 24H19", stroke="white", stroke-width="1.5", stroke-linecap="round", stroke-linejoin="round")
                div(class="container position-relative")
                    div(class="row align-items-center")
                        div(class="col-12 col-lg-6 pt-24")
                            div(class="mw-xl mw-lg-2xl mx-auto mx-lg-0")
                                img(class="img-fluid mb-5", src="images/logo-containerdienst.webp", alt="")
                                h1(class="h2 mb-6") Containerdienste in Ihrer Nähe
                                p(class="mw-lg fs-7 mb-10") Was möchten Sie entsorgen?
                                div(class="d-sm-flex align-items-center mb-24")
                                    a(class="btn d-block d-sm-inline-block mb-4 mb-sm-0 me-sm-6 btn-primary", href="#") jetzt Angebot für Container erhalten!
                                div(class="d-flex flex-column flex-sm-row align-items-center")
                        div(class="col-12 col-lg-6 pt-24")
                            div(class="mw-2xl mx-auto")
                                img(class="img-fluid", src="images/header-img-container-orange-free-mz-v10.png", alt="")
                div(class="d-none navbar-menu position-fixed top-0 start-0 bottom-0 w-75 mw-xs", style="z-index: 9999;")
                    div(class="navbar-close navbar-backdrop position-fixed top-0 start-0 end-0 bottom-0 bg-dark", style="opacity: 75%;")
                    nav(class="position-relative h-100 w-100 d-flex flex-column justify-content-between py-8 px-8 bg-white overflow-auto")
                        div(class="d-flex align-items-center")
                            a(class="me-auto h4 mb-0 text-decoration-none", href="#")
                                img(class="img-fluid", src="flaro-assets/logos/flaro-logo-black.svg", alt="")
                            |         
                            a(class="navbar-close", href="#")
                                svg(width="24", height="24", viewbox="0 0 24 24", fill="none", xmlns="http://www.w3.org/2000/svg")
                                    path(d="M6 18L18 6M6 6L18 18", stroke="#111827", stroke-width="2", stroke-linecap="round", stroke-linejoin="round")
                        div(class="py-16")
                            ul(class="nav flex-column")
                                li(class="nav-item mb-8")
                                    a(class="nav-link text-dark", href="#") Features
                                li(class="nav-item mb-8")
                                    a(class="nav-link text-dark", href="#") Solutions
                                li(class="nav-item mb-8")
                                    a(class="nav-link text-dark", href="#") Resources
                                li(class="nav-item")
                                    a(class="nav-link text-dark", href="#") Pricing
                        div
                            a(class="btn w-100 fw-medium", href="#") Login
                            a(class="btn w-100 btn-primary", href="#") Sign in
        script(src="js/bootstrap/bootstrap.bundle.min.js")
        script(src="js/main.js")
